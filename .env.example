# ---- Server ----
PORT=3000
# Render host WITHOUT scheme, e.g. ai-vm-server.onrender.com
PUBLIC_HOST=your-app.onrender.com
# Shared secret the extension must send on /start-call, /take-over, /hangup
SHARED_SECRET=change-me-to-something-random

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Your 4 Twilio numbers, comma-separated (caller-ID rotation, one call at a time)
TWILIO_NUMBERS=+15615565075,+1XXXXXXXXXX,+1XXXXXXXXXX,+1XXXXXXXXXX
# Your cell — rings and joins the call muted so you can monitor; Take Over connects you
REP_CELL=+13052900693
# Manager/rep name used in the warm-handoff line ("…<name> just walked in…")
REP_NAME=Chris
# Number to DIAL on handoff (warm transfer). Defaults to REP_CELL if unset.
# MANAGER_NUMBER=+13052900693
# How long to ring the manager before giving up on the handoff (ms)
MANAGER_RING_TIMEOUT=30000
# Optional: override the whole warm-handoff line the agent speaks before bridging you in
# HANDOFF_LINE=You know what, my manager just walked in — let me grab them for you, one sec.

# ---- Fish Audio (voice / TTS) ----
FISH_API_KEY=your-fish-api-key
# Your Fish voice model / reference id (the cloned voice to speak with)
FISH_MODEL_ID=your-fish-voice-reference-id
# s2-pro (default — natural-language [bracket] emotion tags) or s1 ((paren) tags)
FISH_TTS_MODEL=s2-pro
# We request 8 kHz PCM from Fish so it maps straight to telephony; change only if needed
FISH_SAMPLE_RATE=8000
# Latency mode: balanced (faster) or normal (best quality)
FISH_LATENCY=balanced
# First-audio latency knob (0-100). chunk_length floor is 100; lower min = faster start.
FISH_MIN_CHUNK_LENGTH=50
FISH_CHUNK_LENGTH=100
# Sampling: lower temperature = steadier delivery (0.6 is a good phone default)
FISH_TEMPERATURE=0.6
FISH_TOP_P=0.7
# Prosody: speed 0.5-2.0 (1.0 = natural; ~1.05 adds BDC energy), volume -20..20 dB
FISH_SPEED=1.0
FISH_VOLUME=0
# Even out perceived loudness across emotional swings (s2-pro only)
FISH_NORMALIZE_LOUDNESS=true

# ---- Deepgram (speech-to-text / turn detection) ----
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-2-phonecall

# ---- Claude (conversation brain) ----
ANTHROPIC_API_KEY=sk-ant-...
# Default Haiku 4.5 for latency; swap to claude-sonnet-4-6 to A/B richer talk
LLM_MODEL=claude-haiku-4-5

# ---- Optional: Neon Postgres call log ----
# DATABASE_URL=postgres://...sslmode=require
