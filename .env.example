# ---- Lead-context webhook server ----
# This server only arms per-call lead context and serves it to the ElevenLabs
# agent. The voice, LLM, STT, and Twilio call handling all live in ElevenLabs now
# (native Twilio integration + the agent config), NOT here.

PORT=3000

# Secret the browser extension must send in the POST /arm body.
SHARED_SECRET=change-me-to-something-random

# Optional: if set, the /eleven/personalization webhook requires ?secret=<this>
# in its URL. Put the same value in the ElevenLabs agent's webhook URL.
# WEBHOOK_SECRET=change-me-too

# ---- Optional first-message override ----
# If 'true', the personalization webhook returns a lead-specific opening line
# ("Hey, this is <AGENT_NAME> over at the dealership — you were looking at that
# <vehicle>, right?"). Requires enabling the first_message override in the Eleven
# agent's security settings. Off by default; dynamic_variables handle the rest.
ELEVEN_OVERRIDE_FIRST_MESSAGE=false
AGENT_NAME=Sam

# ---------------------------------------------------------------------------
# Everything below now lives in the ElevenLabs dashboard, not in env:
#   - Voice (voice id), LLM (Opus), system prompt  -> Agent config
#   - STT / turn-taking / barge-in                 -> handled by Eleven
#   - Phone routing                                -> Agents > Phone Numbers
#                                                     (native Twilio integration)
#   - Per-call lead vars {{lead_context}} etc.     -> this server's webhook
# ---------------------------------------------------------------------------
